#!/bin/sh
# Refuse a commit that would publish a credential.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Bypass for a single commit only when you are certain it is a false positive:
#   git commit --no-verify
#
# The guard is standard library only, so this works before `pip install`.
set -eu

root=$(git rev-parse --show-toplevel)

# Prefer the project virtualenv, then the first interpreter that actually runs.
# On Windows `python` and `python3` can resolve to the Store alias stub: it exists
# on PATH but fails when invoked, so a working interpreter has to be proven, not
# assumed from `command -v`.
python_bin=""
for candidate in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python" python3 python py; do
    if [ -x "$candidate" ] || command -v "$candidate" >/dev/null 2>&1; then
        if "$candidate" -c "import sys" >/dev/null 2>&1; then
            python_bin=$candidate
            break
        fi
    fi
done

if [ -z "$python_bin" ]; then
    echo "pre-commit: no working python interpreter found; the secret guard did not run" >&2
    exit 0
fi

exec "$python_bin" "$root/tools/secret_guard.py"
